{
  "name": "premium-minimal-music-streaming",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\" \"npm run admin\"",
    "start": "node start.js",
    "server": "node server/index.js",
    "admin": "cd auralis-admin && npm run dev",
    "client": "vite --host",
    "build": "vite build --configLoader runner",
    "preview": "vite preview --host 127.0.0.1",
    "sync": "node server/sync.js",
    "app:sync": "npx cap sync",
    "app:open": "npx cap open android",
    "app:build": "cd android && gradlew.bat assembleDebug && copy app\\build\\outputs\\apk\\debug\\app-debug.apk ..\\public\\app-debug.apk"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.0",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/cli": "^8.4.0",
    "@capacitor/core": "^8.4.0",
    "@codetrix-studio/capacitor-google-auth": "^3.4.0-rc.4",
    "@distube/ytdl-core": "^4.16.12",
    "@tabler/icons-react": "^3.44.0",
    "@vitejs/plugin-react": "^5.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "firebase": "^12.13.0",
    "lucide-react": "^0.561.0",
    "multer": "^2.1.1",
    "music-metadata": "^11.12.3",
    "node-fetch": "^3.3.2",
    "nodemailer": "^8.0.10",
    "p5": "^2.3.0",
    "play-dl": "^1.9.7",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-router-dom": "^7.15.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "soundcloud-scraper": "^5.0.3",
    "spotify-uri": "^4.1.0",
    "spotify-url-info": "^3.3.1",
    "sqlite3": "^6.0.1",
    "three": "^0.186.1",
    "vite": "^7.2.7",
    "youtubei.js": "^17.0.1",
    "yt-search": "^2.13.1"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.22",
    "concurrently": "^9.2.1",
    "ngrok": "^5.0.0-beta.2",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19"
  }
}
